<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Kabadiwala Connect | E-Waste Recycling</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">
            ♻️ Kabadiwala Connect
        </div>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="#how-it-works">How It Works</a>
            <a href="#about">About</a>
            <a href="/login" class="login-btn">Login</a>
        </div>
    </nav>


    <!-- Hero Section -->
    <section class="hero">

        <div class="hero-content">

            <p class="tagline">
                ♻️ INFORMAL TO FORMAL RECYCLING
            </p>

            <h1>
                Turn E-Waste<br>
                <span>Into Value.</span>
            </h1>

            <p class="hero-text">
                Kabadiwala Connect bridges the gap between
                informal e-waste collectors and formal recyclers —
                making collection, pricing and traceability simple.
            </p>

            <div class="hero-buttons">

                <a href="/login" class="primary-btn">
                    Start Collecting →
                </a>

                <a href="/login" class="secondary-btn">
                    Recycler Login
                </a>

            </div>

        </div>


        <!-- Hero Information Card -->
        <div class="hero-card">

            <div class="card-icon">
                📱
            </div>

            <h3>
                Have E-Waste?
            </h3>

            <p>
                Record your e-waste, estimate its value,
                and connect it to the recycling chain.
            </p>

            <div class="price-box">
                <span>Example Estimated Value</span>
                <strong>₹2,500 – ₹3,200</strong>
            </div>

            <div style="
                margin-top: 18px;
                padding: 12px;
                background: #f0fdf4;
                border-radius: 10px;
                font-size: 14px;
            ">
                🔎 Track every collection from
                request to completion.
            </div>

        </div>

    </section>


    <!-- How It Works -->
    <section class="features" id="how-it-works">

        <h2>
            How Kabadiwala Connect Works
        </h2>

        <div class="feature-container">

            <div class="feature-card">

                <div class="feature-icon">
                    📦
                </div>

                <h3>
                    1. Collect
                </h3>

                <p>
                    Informal collectors register e-waste
                    collections digitally with material,
                    weight and pickup details.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🤝
                </div>

                <h3>
                    2. Connect
                </h3>

                <p>
                    Recyclers receive collection requests
                    and manage the complete pickup workflow.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🔎
                </div>

                <h3>
                    3. Track
                </h3>

                <p>
                    Every request gets a traceable journey
                    from creation and assignment to pickup
                    and completion.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    ♻️
                </div>

                <h3>
                    4. Recycle
                </h3>

                <p>
                    Completed collections move closer to
                    India's formal e-waste recycling ecosystem.
                </p>

            </div>

        </div>

    </section>


    <!-- Problem / Solution -->
    <section class="about" id="about">

        <h2>
            From Informal Collection to a Formal Recycling Chain
        </h2>

        <p>
            A large part of India's e-waste reaches recyclers
            through informal waste collectors and local
            aggregators. Kabadiwala Connect brings these
            collectors into a connected digital workflow.
        </p>

        <div style="
            max-width: 900px;
            margin: 30px auto 0;
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        ">

            <div style="
                padding: 18px 25px;
                background: white;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            ">
                👤 Informal Collector
            </div>

            <div style="
                padding: 18px 25px;
                background: white;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            ">
                →
            </div>

            <div style="
                padding: 18px 25px;
                background: white;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            ">
                📦 Digital Collection
            </div>

            <div style="
                padding: 18px 25px;
                background: white;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            ">
                →
            </div>

            <div style="
                padding: 18px 25px;
                background: white;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            ">
                ♻️ Formal Recycler
            </div>

        </div>

    </section>


    <!-- CTA -->
    <section style="
        text-align: center;
        padding: 70px 20px;
    ">

        <h2>
            Ready to Connect the Recycling Chain?
        </h2>

        <p style="
            max-width: 650px;
            margin: 15px auto 25px;
        ">
            Bring collectors, recyclers and e-waste together
            through one simple digital platform.
        </p>

        <a href="/register" class="primary-btn">
            Create Your Account →
        </a>

    </section>


    <!-- Footer -->
    <footer>
        <p>
            © 2026 Kabadiwala Connect |
            E-Waste for a Better Tomorrow ♻️
        </p>
    </footer>

