<!-- E-WASTE TRACEABILITY / JOURNEY -->
<!-- ========================================= -->

<div style="
    margin-top:25px;
    padding:18px;
    background:#f8fafc;
    border:1px solid #e2e8f0;
    border-radius:12px;
">

    <h3 style="
        margin:0 0 6px 0;
    ">
        ♻️ E-Waste Journey
    </h3>

    <p style="
        margin:0 0 15px 0;
        color:#64748b;
        font-size:13px;
    ">
        Track the collection from request to recycling handover.
    </p>


    <!-- TRACEABILITY ID -->

    <div style="
        margin-bottom:15px;
        padding:10px 12px;
        background:white;
        border:1px solid #e5e7eb;
        border-radius:8px;
        font-size:13px;
    ">

        <strong>Traceability ID:</strong>

        <span style="
            font-family:monospace;
            color:#334155;
        ">
            KC-<%= String(item._id).slice(-8).toUpperCase() %>
        </span>

    </div>


    <!-- JOURNEY -->

    <div style="
        display:flex;
        flex-direction:column;
        gap:0;
    ">


        <!-- REQUEST CREATED -->

        <%
            const traceHistory =
                item.statusHistory || [];

            const traceStatuses =
                traceHistory.map(
                    entry => entry.status
                );

            const tracePending =
                traceHistory.find(
                    entry => entry.status === "Pending"
                );

            const traceAccepted =
                traceHistory.find(
                    entry => entry.status === "Accepted"
                );

            const tracePickedUp =
                traceHistory.find(
                    entry => entry.status === "Picked Up"
                );

            const traceCompleted =
                traceHistory.find(
                    entry => entry.status === "Completed"
                );

            const traceRejected =
                traceHistory.find(
                    entry => entry.status === "Rejected"
                );
        %>


        <div style="
            display:flex;
            gap:12px;
            align-items:flex-start;
        ">

            <div style="
                width:28px;
                height:28px;
                border-radius:50%;
                background:#dcfce7;
                display:flex;
                align-items:center;
                justify-content:center;
                flex-shrink:0;
                font-size:14px;
            ">
                ✓
            </div>

            <div style="flex:1;">

                <strong>
                    Request Created
                </strong>

                <% if (tracePending && tracePending.timestamp) { %>

                    <div style="
                        font-size:12px;
                        color:#64748b;
                        margin-top:3px;
                    ">
                        <%= new Date(
                            tracePending.timestamp
                        ).toLocaleString(
                            "en-IN",
                            {
                                day:"2-digit",
                                month:"short",
                                year:"numeric",
                                hour:"2-digit",
                                minute:"2-digit"
                            }
                        ) %>
                    </div>

                <% } %>

            </div>

        </div>


        <!-- CONNECTOR -->

        <div style="
            width:2px;
            height:18px;
            background:#cbd5e1;
            margin-left:13px;
        "></div>


        <!-- COLLECTOR ASSIGNED -->

        <div style="
            display:flex;
            gap:12px;
            align-items:flex-start;
        ">

<div class="<%= item.collector && item.collector.collectorId
    ? 'trace-dot trace-done'
    : 'trace-dot trace-pending' %>"
    style="
        width:28px;
        height:28px;
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        flex-shrink:0;
    "
>

                <%= item.collector && item.collector.collectorId
                    ? "✓"
                    : "2" %>

            </div>

            <div style="flex:1;">

                <strong>
                    Collector Assigned
                </strong>

                <% if (
                    item.collector &&
                    item.collector.collectorId
                ) { %>

                    <div style="
                        font-size:12px;
                        color:#64748b;
                        margin-top:3px;
                    ">
                        <%= item.collector.name || "Collector" %>
                        ·
                        <%= item.collector.area || "Area not available" %>
                    </div>

                <% } else { %>

                    <div style="
                        font-size:12px;
                        color:#94a3b8;
                        margin-top:3px;
                    ">
                        Waiting for collector assignment
                    </div>

                <% } %>

            </div>

        </div>


        <!-- CONNECTOR -->

        <div style="
            width:2px;
            height:18px;
            background:#cbd5e1;
            margin-left:13px;
        "></div>


        <!-- ACCEPTED -->

        <div style="
            display:flex;
            gap:12px;
            align-items:flex-start;
        ">

            <div class="<%= traceAccepted
    ? 'trace-dot trace-done'
    : 'trace-dot trace-pending' %>"
    style="
        width:28px;
        height:28px;
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        flex-shrink:0;
    "
>
                <%= traceAccepted ? "✓" : "3" %>

            </div>

            <div style="flex:1;">

                <strong>
                    Collection Accepted
                </strong>

                <% if (traceAccepted && traceAccepted.timestamp) { %>

                    <div style="
                        font-size:12px;
                        color:#64748b;
                        margin-top:3px;
                    ">
                        <%= new Date(
                            traceAccepted.timestamp
                        ).toLocaleString(
                            "en-IN",
                            {
                                day:"2-digit",
                                month:"short",
                                year:"numeric",
                                hour:"2-digit",
                                minute:"2-digit"
                            }
                        ) %>
                    </div>

                <% } else { %>

                    <div style="
                        font-size:12px;
                        color:#94a3b8;
                        margin-top:3px;
                    ">
                        Waiting for acceptance
                    </div>

                <% } %>

            </div>

        </div>


        <!-- CONNECTOR -->

        <div style="
            width:2px;
            height:18px;
            background:#cbd5e1;
            margin-left:13px;
        "></div>


        <!-- PICKED UP -->

        <div style="
            display:flex;
            gap:12px;
            align-items:flex-start;
        ">

            <div class="<%= tracePickedUp
    ? 'trace-dot trace-done'
    : 'trace-dot trace-pending' %>"
    style="
        width:28px;
        height:28px;
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        flex-shrink:0;
    "
>

                <%= tracePickedUp ? "✓" : "4" %>

            </div>

            <div style="flex:1;">

                <strong>
                    E-Waste Picked Up
                </strong>

                <% if (tracePickedUp && tracePickedUp.timestamp) { %>

                    <div style="
                        font-size:12px;
                        color:#64748b;
                        margin-top:3px;
                    ">
                        <%= new Date(
                            tracePickedUp.timestamp
                        ).toLocaleString(
                            "en-IN",
                            {
                                day:"2-digit",
                                month:"short",
                                year:"numeric",
                                hour:"2-digit",
                                minute:"2-digit"
                            }
                        ) %>
                    </div>

                <% } else { %>

                    <div style="
                        font-size:12px;
                        color:#94a3b8;
                        margin-top:3px;
                    ">
                        Awaiting pickup
                    </div>

                <% } %>

            </div>

        </div>


        <!-- CONNECTOR -->

        <div style="
            width:2px;
            height:18px;
            background:#cbd5e1;
            margin-left:13px;
        "></div>


        <!-- COMPLETED -->

        <div style="
            display:flex;
            gap:12px;
            align-items:flex-start;
        ">

           <div class="<%= traceCompleted
    ? 'trace-dot trace-done'
    : 'trace-dot trace-pending' %>"
    style="
        width:28px;
        height:28px;
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        flex-shrink:0;
    "
>

                <%= traceCompleted ? "✓" : "5" %>

            </div>

            <div style="flex:1;">

                <strong>
                    Collection Completed
                </strong>

                <% if (traceCompleted && traceCompleted.timestamp) { %>

                    <div style="
                        font-size:12px;
                        color:#64748b;
                        margin-top:3px;
                    ">
                        <%= new Date(
                            traceCompleted.timestamp
                        ).toLocaleString(
                            "en-IN",
                            {
                                day:"2-digit",
                                month:"short",
                                year:"numeric",
                                hour:"2-digit",
                                minute:"2-digit"
                            }
                        ) %>
                    </div>

                <% } else { %>

                    <div style="
                        font-size:12px;
                        color:#94a3b8;
                        margin-top:3px;
                    ">
                        Not completed yet
                    </div>

                <% } %>

            </div>

        </div>


        <!-- REJECTED -->

        <% if (traceRejected) { %>

            <div style="
                margin-top:15px;
                padding:10px;
                background:#fff1f2;
                border:1px solid #fecdd3;
                border-radius:8px;
                color:#be123c;
                font-size:13px;
            ">

                🔴
                <strong>Collection Rejected</strong>

                <% if (traceRejected.timestamp) { %>

                    <br>

                    <span style="font-size:12px;">
                        <%= new Date(
                            traceRejected.timestamp
                        ).toLocaleString(
                            "en-IN",
                            {
                                day:"2-digit",
                                month:"short",
                                year:"numeric",
                                hour:"2-digit",
                                minute:"2-digit"
                            }
                        ) %>
                    </span>

                <% } %>

            </div>

        <% } %>


    </div>

</div>

                            <!-- ========================= -->
                            <!-- STATUS HISTORY -->
                            <!-- ========================= -->


                            <% if (
                                item.statusHistory &&
                                item.statusHistory.length > 0
                            ) { %>


                                <div style="margin-top:25px;">


                                    <h3>
                                        🕒 Status History
                                    </h3>



                                    <div style="
                                        margin-top:15px;
                                        padding:15px;
                                        background:#fff;
                                        border-radius:10px;
                                        border:1px solid #eee;
                                    ">


                                        <% item.statusHistory.forEach(
                                            historyItem => {
                                        %>


                                            <div style="
                                                display:flex;
                                                justify-content:space-between;
                                                align-items:center;
                                                padding:10px 0;
                                                border-bottom:1px solid #eee;
                                            ">


                                                <strong>

                                                    <%= historyItem.status %>

                                                </strong>


                                                <span style="
                                                    font-size:13px;
                                                    color:#777;
                                                ">


                                                    <%= new Date(
                                                        historyItem.timestamp
                                                    ).toLocaleString(
                                                        'en-IN',
                                                        {
                                                            day: '2-digit',
                                                            month: 'short',
                                                            year: 'numeric',
                                                            hour: '2-digit',
                                                            minute: '2-digit'
                                                        }
                                                    ) %>


                                                </span>


                                            </div>


                                        <% }) %>


                                    </div>


                                </div>


                            <% } %>



                            <!-- ========================= -->
                            <!-- LARGE PHOTO -->
                            <!-- ========================= -->


                            <% if (item.photo) { %>


                                <div style="margin-top:20px;">


                                    <strong>
                                        📷 E-waste Photo
                                    </strong>


                                    <br>
                                    <br>


                                    <img
                                        src="/uploads/<%= item.photo %>"
                                        alt="E-waste Photo"
                                        style="
                                            width:200px;
                                            max-height:200px;
                                            object-fit:cover;
                                            border-radius:10px;
                                        "
                                    >


                                </div>


                            <% } %>



                            <br>



                            <!-- CLOSE BUTTON -->


                            <button
    type="button"
    class="action-btn"
    onclick="closeDetails('<%= item._id %>')"
>
    ✕ Close Details
</button>

                        </div>


                    <% }) %>


                </div>


            <% } %>


        </div>


    </div>



    <!-- ========================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================= -->


    <script>


        // =========================
        // FILTER COLLECTIONS
        // =========================


        function filterCollections(status, button) {


            const items =
                document.querySelectorAll(
                    ".collection-item"
                );


            const buttons =
                document.querySelectorAll(
                    ".filter-btn"
                );


            buttons.forEach(btn => {

                btn.classList.remove("active");

            });


            button.classList.add("active");


            items.forEach(item => {


                const itemStatus =
                    item.dataset.status;


                if (
                    status === "All" ||
                    itemStatus === status
                ) {

                    item.style.display =
                        "grid";

                } else {

                    item.style.display =
                        "none";

                }


            });


        }



        // =========================
        // SHOW DETAILS
        // =========================


        // =========================
// SHOW DETAILS
// =========================

function showDetails(id) {

    const details = document.getElementById("details-" + id);

    if (!details) {
        console.log("Details panel not found:", id);
        return;
    }

    details.style.setProperty("display", "block", "important");

}


// =========================
// CLOSE DETAILS
// =========================

function closeDetails(id) {

    const details = document.getElementById("details-" + id);

    if (!details) {
        console.log("Details panel not found:", id);
        return;
    }

    details.style.setProperty("display", "none", "important");

}


    </script>


</body>

</html>