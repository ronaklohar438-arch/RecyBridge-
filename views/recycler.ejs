<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Recycler Dashboard - Kabadiwala Connect</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <!-- ========================= -->
    <!-- NAVBAR -->
    <!-- ========================= -->

    <nav class="navbar">
    <div class="logo">
        ♻️ Kabadiwala Connect
    </div>

    <div class="nav-links">
        <a href="/">Home</a>
        <a href="/recycler">Dashboard</a>
        <a href="/logout" class="login-btn">Logout</a>
    </div>
</nav>




    <!-- ========================= -->
    <!-- MAIN DASHBOARD -->
    <!-- ========================= -->

    <div class="recycler-dashboard">


        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->

        <div class="recycler-header">

            <h1>
    Welcome, <%= userName %> 👋
</h1>

            <p>
                Manage e-waste collection requests
            </p>

        </div>



        <!-- ========================= -->
        <!-- MAIN STATISTICS -->
        <!-- ========================= -->

        <div class="stats-container">


            <div class="stat-card">

                <span>
                    🟡
                </span>

                <p>
                    Pending Requests
                </p>

                <h2>
                    <%= pendingCount %>
                </h2>

            </div>



            <div class="stat-card">

                <span>
                    🔵
                </span>

                <p>
                    Accepted Collections
                </p>

                <h2>
                    <%= acceptedCount %>
                </h2>

            </div>



            <div class="stat-card">

                <span>
                    🟢
                </span>

                <p>
                    Completed
                </p>

                <h2>
                    <%= completedCount %>
                </h2>

            </div>


        </div>



        <!-- ========================= -->
        <!-- ANALYTICS -->
        <!-- ========================= -->

        <div class="recent-section">

            <h2>
                📊 Collection Analytics
            </h2>



            <!-- OVERALL ANALYTICS -->

            <div class="stats-container">


                <div class="stat-card">

                    <span>
                        📦
                    </span>

                    <p>
                        Total Collections
                    </p>

                    <h2>
                        <%= totalCollections %>
                    </h2>

                </div>



                <div class="stat-card">

                    <span>
                        ⚖️
                    </span>

                    <p>
                        Total E-Waste
                    </p>

                    <h2>
                        <%= Number(totalWeight).toFixed(1) %> kg
                    </h2>

                </div>



                <div class="stat-card">

                    <span>
                        💰
                    </span>

                    <p>
                        Total Value
                    </p>

                    <h2>
                        ₹<%= totalValue %>
                    </h2>

                </div>


            </div>



            <!-- ========================= -->
            <!-- STATUS ANALYTICS -->
            <!-- ========================= -->

            <h3 style="margin:30px 0 15px;">

                Collection Status

            </h3>



            <div class="stats-container">


                <div class="stat-card">

                    <span>
                        🟡
                    </span>

                    <p>
                        Pending
                    </p>

                    <h2>
                        <%= pendingCount %>
                    </h2>

                </div>



                <div class="stat-card">

                    <span>
                        🔵
                    </span>

                    <p>
                        Accepted
                    </p>

                    <h2>
                        <%= acceptedCount %>
                    </h2>

                </div>



                <div class="stat-card">

                    <span>
                        🚚
                    </span>

                    <p>
                        Picked Up
                    </p>

                    <h2>
                        <%= pickedUpCount %>
                    </h2>

                </div>



                <div class="stat-card">

                    <span>
                        🟢
                    </span>

                    <p>
                        Completed
                    </p>

                    <h2>
                        <%= completedCount %>
                    </h2>

                </div>



                <div class="stat-card">

                    <span>
                        🔴
                    </span>

                    <p>
                        Rejected
                    </p>

                    <h2>
                        <%= rejectedCount %>
                    </h2>

                </div>


            </div>



            <!-- ========================= -->
            <!-- MATERIAL ANALYTICS -->
            <!-- ========================= -->

            <h3 style="margin:30px 0 15px;">

                ♻️ Material-wise Collections

            </h3>



            <% if (Object.keys(materialCounts).length === 0) { %>


                <div class="collection-details">

                    <p>
                        No material data available.
                    </p>

                </div>


            <% } else { %>


                <div class="collection-details">


                    <% Object.entries(materialCounts).forEach(([material, count]) => { %>


                        <div style="
                            display:flex;
                            justify-content:space-between;
                            align-items:center;
                            padding:12px 15px;
                            margin-bottom:8px;
                            background:white;
                            border:1px solid #eee;
                            border-radius:8px;
                        ">


                            <span>

                                ♻️
                                <%= material %>

                            </span>


                            <strong>

                                <%= count %>
                                collections

                            </strong>


                        </div>


                    <% }) %>


                </div>


            <% } %>


        </div>



        <!-- ========================= -->
        <!-- STATUS FILTERS -->
        <!-- ========================= -->

        <div class="status-filters">


            <button
                type="button"
                class="filter-btn active"
                onclick="filterCollections('All', this)">

                All

            </button>



            <button
                type="button"
                class="filter-btn"
                onclick="filterCollections('Pending', this)">

                Pending

            </button>



            <button
                type="button"
                class="filter-btn"
                onclick="filterCollections('Accepted', this)">

                Accepted

            </button>



            <button
                type="button"
                class="filter-btn"
                onclick="filterCollections('Picked Up', this)">

                Picked Up

            </button>



            <button
                type="button"
                class="filter-btn"
                onclick="filterCollections('Completed', this)">

                Completed

            </button>



            <button
                type="button"
                class="filter-btn"
                onclick="filterCollections('Rejected', this)">

                Rejected

            </button>


        </div>



        <!-- ========================= -->
        <!-- COLLECTION REQUESTS -->
        <!-- ========================= -->

        <div class="recent-section">


            <h2>
                Collection Requests
            </h2>



            <% if (collections.length === 0) { %>


                <div class="empty-state">

                    <h3>
                        No collection requests
                    </h3>

                    <p>
                        New e-waste collection requests will appear here.
                    </p>

                </div>


            <% } else { %>


                <div class="collection-table">


                    <!-- TABLE HEADER -->

                    <div class="table-header">


                        <div>
                            Photo
                        </div>


                        <div>
                            Material
                        </div>


                        <div>
                            Weight
                        </div>


                        <div>
                            Value
                        </div>


                        <div>
                            Status & Actions
                        </div>


                    </div>



                    <!-- ========================= -->
                    <!-- COLLECTION ROWS -->
                    <!-- ========================= -->


                    <% collections.forEach(item => { %>


                        <div
                            class="table-row collection-item"
                            data-status="<%= item.status %>"
                        >


                            <!-- PHOTO -->

                            <div>


                                <% if (item.photo) { %>


                                    <img
                                        src="/uploads/<%= item.photo %>"
                                        alt="E-waste"
                                        style="
                                            width:60px;
                                            height:60px;
                                            object-fit:cover;
                                            border-radius:8px;
                                        "
                                    >


                                <% } else { %>


                                    <span>
                                        No Photo
                                    </span>


                                <% } %>


                            </div>



                            <!-- MATERIAL -->

                            <div>

                                <strong>

                                    <%= item.material %>

                                </strong>

                            </div>



                            <!-- WEIGHT -->

                            <div>

                                <%= item.weight %>
                                kg

                            </div>



                            <!-- VALUE -->

                            <div>

                                ₹<%= item.value %>

                            </div>



                            <!-- ========================= -->
                            <!-- STATUS + ACTIONS -->
                            <!-- ========================= -->

                            <div class="status-container">


                                <!-- CURRENT STATUS -->


                                <% if (item.status === "Pending") { %>


                                    <span class="status pending">

                                        🟡 Pending

                                    </span>


                                <% } else if (item.status === "Accepted") { %>


                                    <span class="status accepted">

                                        🔵 Accepted

                                    </span>


                                <% } else if (item.status === "Picked Up") { %>


                                    <span class="status accepted">

                                        🚚 Picked Up

                                    </span>


                                <% } else if (item.status === "Rejected") { %>


                                    <span class="status rejected">

                                        🔴 Rejected

                                    </span>


                                <% } else if (item.status === "Completed") { %>


                                    <span class="status completed">

                                        🟢 Completed

                                    </span>


                                <% } %>



                                <!-- ========================= -->
                                <!-- DATABASE STATUS TIMELINE -->
                                <!-- ========================= -->


                                <div class="status-timeline">


                                    <%

                                        const history =
                                            item.statusHistory || [];

                                        const historyStatuses =
                                            history.map(
                                                entry => entry.status
                                            );

                                        const hasPending =
                                            historyStatuses.includes(
                                                "Pending"
                                            );

                                        const hasAccepted =
                                            historyStatuses.includes(
                                                "Accepted"
                                            );

                                        const hasPickedUp =
                                            historyStatuses.includes(
                                                "Picked Up"
                                            );

                                        const hasCompleted =
                                            historyStatuses.includes(
                                                "Completed"
                                            );

                                        const isRejected =
                                            historyStatuses.includes(
                                                "Rejected"
                                            );

                                    %>



                                    <!-- ========================= -->
                                    <!-- PENDING -->
                                    <!-- ========================= -->


                                    <div class="
                                        timeline-step
                                        <%= hasPending
                                            ? 'completed-step'
                                            : 'future-step' %>
                                    ">


                                        <span>

                                            <%= hasPending
                                                ? '✓'
                                                : '1' %>

                                        </span>


                                        <small>
                                            Pending
                                        </small>


                                        <%

                                            const pendingEntry =
                                                history.find(
                                                    h =>
                                                        h.status ===
                                                        "Pending"
                                                );

                                        %>


                                        <% if (pendingEntry) { %>


                                            <small
                                                style="font-size:10px;"
                                            >

                                                <%= new Date(
                                                    pendingEntry.timestamp
                                                ).toLocaleString(
                                                    'en-IN',
                                                    {
                                                        day: '2-digit',
                                                        month: 'short',
                                                        hour: '2-digit',
                                                        minute: '2-digit'
                                                    }
                                                ) %>

                                            </small>


                                        <% } %>


                                    </div>



                                    <div class="timeline-line"></div>



                                    <!-- ========================= -->
                                    <!-- ACCEPTED -->
                                    <!-- ========================= -->


                                    <div class="
                                        timeline-step
                                        <%= hasAccepted
                                            ? 'completed-step'
                                            : 'future-step' %>
                                    ">


                                        <span>

                                            <%= hasAccepted
                                                ? '✓'
                                                : '2' %>

                                        </span>


                                        <small>
                                            Accepted
                                        </small>


                                        <%

                                            const acceptedEntry =
                                                history.find(
                                                    h =>
                                                        h.status ===
                                                        "Accepted"
                                                );

                                        %>


                                        <% if (acceptedEntry) { %>


                                            <small
                                                style="font-size:10px;"
                                            >

                                                <%= new Date(
                                                    acceptedEntry.timestamp
                                                ).toLocaleString(
                                                    'en-IN',
                                                    {
                                                        day: '2-digit',
                                                        month: 'short',
                                                        hour: '2-digit',
                                                        minute: '2-digit'
                                                    }
                                                ) %>

                                            </small>


                                        <% } %>


                                    </div>



                                    <div class="timeline-line"></div>



                                    <!-- ========================= -->
                                    <!-- PICKED UP -->
                                    <!-- ========================= -->


                                    <div class="
                                        timeline-step
                                        <%= hasPickedUp
                                            ? 'completed-step'
                                            : 'future-step' %>
                                    ">


                                        <span>

                                            <%= hasPickedUp
                                                ? '✓'
                                                : '3' %>

                                        </span>


                                        <small>
                                            Picked Up
                                        </small>


                                        <%

                                            const pickedUpEntry =
                                                history.find(
                                                    h =>
                                                        h.status ===
                                                        "Picked Up"
                                                );

                                        %>


                                        <% if (pickedUpEntry) { %>


                                            <small
                                                style="font-size:10px;"
                                            >

                                                <%= new Date(
                                                    pickedUpEntry.timestamp
                                                ).toLocaleString(
                                                    'en-IN',
                                                    {
                                                        day: '2-digit',
                                                        month: 'short',
                                                        hour: '2-digit',
                                                        minute: '2-digit'
                                                    }
                                                ) %>

                                            </small>


                                        <% } %>


                                    </div>



                                    <div class="timeline-line"></div>



                                    <!-- ========================= -->
                                    <!-- COMPLETED -->
                                    <!-- ========================= -->


                                    <div class="
                                        timeline-step
                                        <%= hasCompleted
                                            ? 'completed-step'
                                            : 'future-step' %>
                                    ">


                                        <span>

                                            <%= hasCompleted
                                                ? '✓'
                                                : '4' %>

                                        </span>


                                        <small>
                                            Completed
                                        </small>


                                        <%

                                            const completedEntry =
                                                history.find(
                                                    h =>
                                                        h.status ===
                                                        "Completed"
                                                );

                                        %>


                                        <% if (completedEntry) { %>


                                            <small
                                                style="font-size:10px;"
                                            >

                                                <%= new Date(
                                                    completedEntry.timestamp
                                                ).toLocaleString(
                                                    'en-IN',
                                                    {
                                                        day: '2-digit',
                                                        month: 'short',
                                                        hour: '2-digit',
                                                        minute: '2-digit'
                                                    }
                                                ) %>

                                            </small>


                                        <% } %>


                                    </div>


                                </div>



                                <!-- ========================= -->
                                <!-- REJECTED MESSAGE -->
                                <!-- ========================= -->


                                <% if (isRejected) { %>


                                    <div style="
                                        margin-top:8px;
                                        color:#d32f2f;
                                        font-size:13px;
                                    ">

                                        🔴 This collection was rejected.

                                    </div>


                                <% } %>



                                <!-- ========================= -->
                                <!-- ACTION BUTTONS -->
                                <!-- ========================= -->


                                <div style="margin-top:10px;">

<!-- COLLECTOR ASSIGNMENT -->

<% if (item.status === "Pending") { %>

<div style="
    margin-bottom:10px;
    padding:12px;
    background:#f8faf9;
    border:1px solid #e5e7eb;
    border-radius:10px;
">

    <div style="
        font-weight:600;
        margin-bottom:8px;
    ">
        👤 Collector Assignment
    </div>

    <% if (item.collector && item.collector.collectorId) { %>

        <div style="font-size:13px; line-height:1.6;">
            <strong>Name:</strong>
            <%= item.collector.name || "Not available" %>
            <br>

            <strong>Phone:</strong>
            <%= item.collector.phone || "Not available" %>
            <br>

            <strong>Area:</strong>
            <%= item.collector.area || "Not available" %>
        </div>

        <div style="
            margin-top:8px;
            padding:7px 10px;
            background:#e8f5e9;
            color:#2e7d32;
            border-radius:7px;
            font-size:13px;
            font-weight:600;
        ">
            ✓ Collector Assigned
        </div>

    <% } else if (collectors && collectors.length > 0) { %>

        <form
            action="/recycler/assign/<%= item._id %>"
            method="POST"
        >

            <div style="
                display:flex;
                gap:8px;
                align-items:center;
                flex-wrap:wrap;
            ">

                <select
                    name="collectorId"
                    required
                    style="
                        padding:9px 10px;
                        border:1px solid #ccc;
                        border-radius:8px;
                        min-width:220px;
                        background:white;
                    "
                >

                    <option value="">
                        -- Select Collector --
                    </option>

                    <% collectors.forEach(collector => { %>

                        <option value="<%= collector._id %>">
                            <%= collector.name %>
                            -
                            <%= collector.area || "Area not specified" %>
                        </option>

                    <% }) %>

                </select>

                <button
                    type="submit"
                    class="action-btn accept"
                >
                    👤 Assign Collector
                </button>

            </div>

        </form>

    <% } else { %>

        <div style="
            padding:9px 10px;
            background:#fff8e1;
            border:1px solid #ffe082;
            border-radius:7px;
            color:#856404;
            font-size:13px;
        ">
            ⚠️ No collectors available.
            Please create a collector profile first.
        </div>

    <% } %>

</div>

<% } %>
                                    <!-- VIEW DETAILS -->


                                    <button
                                        type="button"
                                        class="action-btn"
                                        onclick="showDetails('<%= item._id %>')"
                                    >

                                        👁 View Details

                                    </button>



                                    <!-- ========================= -->
                                    <!-- PENDING ACTIONS -->
                                    <!-- ========================= -->


                                    <% if (item.status === "Pending") { %>


                                        <form
                                            action="/recycler/accept/<%= item._id %>"
                                            method="POST"
                                            style="display:inline;"
                                        >


                                            <button
                                                type="submit"
                                                class="action-btn accept"
                                            >

                                                Accept

                                            </button>


                                        </form>



                                        <form
                                            action="/recycler/reject/<%= item._id %>"
                                            method="POST"
                                            style="display:inline;"
                                        >


                                            <button
                                                type="submit"
                                                class="action-btn reject"
                                            >

                                                Reject

                                            </button>


                                        </form>


                                    <% } else if (item.status === "Accepted") { %>


                                        <!-- ========================= -->
                                        <!-- ACCEPTED -->
                                        <!-- ========================= -->


                                        <form
                                            action="/recycler/pickup/<%= item._id %>"
                                            method="POST"
                                            style="display:inline;"
                                        >


                                            <button
                                                type="submit"
                                                class="action-btn"
                                            >

                                                🚚 Mark Picked Up

                                            </button>


                                        </form>


                                    <% } else if (item.status === "Picked Up") { %>


                                        <!-- ========================= -->
                                        <!-- PICKED UP -->
                                        <!-- ========================= -->


                                        <form
                                            action="/recycler/complete/<%= item._id %>"
                                            method="POST"
                                            style="display:inline;"
                                        >


                                            <button
                                                type="submit"
                                                class="action-btn complete"
                                            >

                                                ♻️ Mark Completed

                                            </button>


                                        </form>


                                    <% } else if (item.status === "Rejected") { %>


                                        <span>

                                            ✕ Rejected

                                        </span>


                                    <% } else if (item.status === "Completed") { %>


                                        <span>

                                            ✓ Completed

                                        </span>


                                    <% } %>


                                </div>


                            </div>


                        </div>



                        <!-- ========================= -->
                        <!-- DETAILS PANEL -->
                        <!-- ========================= -->


                        <div
                            id="details-<%= item._id %>"
                            class="collection-details"
                            style="display:none;"
                        >


                            <h3>

                                📋 Collection Details

                            </h3>



                            <div class="details-grid">


                                <!-- MATERIAL -->


                                <div>

                                    <strong>
                                        ♻️ Material
                                    </strong>

                                    <p>
                                        <%= item.material %>
                                    </p>

                                </div>



                                <!-- WEIGHT -->


                                <div>

                                    <strong>
                                        ⚖️ Weight
                                    </strong>

                                    <p>
                                        <%= item.weight %>
                                        kg
                                    </p>

                                </div>



                                <!-- VALUE -->


                                <div>

                                    <strong>
                                        💰 Estimated Value
                                    </strong>

                                    <p>
                                        ₹<%= item.value %>
                                    </p>

                                </div>



                                <!-- LOCATION -->


                                <div>

                                    <strong>
                                        📍 Pickup Location
                                    </strong>

                                    <p>
                                        <%= item.pickupLocation ||
                                            "Not provided" %>
                                    </p>

                                </div>



                                <!-- CONTACT -->


                                <div>

                                    <strong>
                                        📞 Contact Number
                                    </strong>

                                    <p>
                                        <%= item.contactNumber ||
                                            "Not provided" %>
                                    </p>

                                </div>



                                <!-- PICKUP DATE -->


                                <div>

                                    <strong>
                                        📅 Pickup Date
                                    </strong>

                                    <p>


                                        <% if (item.pickupDate) { %>


                                            <%= new Date(
                                                item.pickupDate
                                            ).toLocaleDateString(
                                                'en-IN'
                                            ) %>


                                        <% } else { %>


                                            Not provided


                                        <% } %>


                                    </p>

                                </div>



                                <!-- CURRENT STATUS -->


                                <div>

                                    <strong>
                                        🔄 Current Status
                                    </strong>

                                    <p>
                                        <%= item.status %>
                                    </p>

                                </div>



                                <!-- CREATED AT -->


                                <div>

                                    <strong>
                                        🕒 Created At
                                    </strong>

                                    <p>


                                        <% if (item.createdAt) { %>


                                            <%= new Date(
                                                item.createdAt
                                            ).toLocaleDateString(
                                                'en-IN'
                                            ) %>


                                        <% } else { %>


                                            Not available


                                        <% } %>


                                    </p>

                                </div>


                            </div>



                            <!-- ========================= -->
                            <!-- COLLECTOR INFORMATION -->
                            <!-- ========================= -->

                            <div style="margin-top:25px;">

                                <h3>
                                    👤 Collector Assignment
                                </h3>

                                <% if (item.collector && item.collector.collectorId) { %>

                                    <div style="
                                        margin-top:15px;
                                        padding:15px;
                                        background:#fff;
                                        border-radius:10px;
                                        border:1px solid #eee;
                                    ">

                                        <p>
                                            <strong>Name:</strong>
                                            <%= item.collector.name %>
                                        </p>

                                        <p>
                                            <strong>Phone:</strong>
                                            <%= item.collector.phone %>
                                        </p>

                                        <p>
                                            <strong>Area:</strong>
                                            <%= item.collector.area %>
                                        </p>

                                        <p style="margin-bottom:0;">
                                            <strong>Assignment:</strong>
                                            <span style="color:green;">
                                                ✓ Collector Assigned
                                            </span>
                                        </p>

                                    </div>

                                <% } else if (item.status === "Pending") { %>

                                    <% if (collectors && collectors.length > 0) { %>

                                        <form
                                            action="/recycler/assign/<%= item._id %>"
                                            method="POST"
                                            style="
                                                margin-top:15px;
                                                padding:15px;
                                                background:#fff;
                                                border-radius:10px;
                                                border:1px solid #eee;
                                            "
                                        >

                                            <label
                                                for="collector-<%= item._id %>"
                                                style="display:block;margin-bottom:8px;font-weight:600;"
                                            >
                                                Select Collector
                                            </label>

                                            <select
                                                id="collector-<%= item._id %>"
                                                name="collectorId"
                                                required
                                                style="
                                                    width:100%;
                                                    padding:10px;
                                                    border:1px solid #ccc;
                                                    border-radius:8px;
                                                    margin-bottom:10px;
                                                "
                                            >

                                                <option value="">
                                                    -- Select Collector --
                                                </option>

                                                <% collectors.forEach(collector => { %>

                                                    <option value="<%= collector._id %>">
                                                        <%= collector.name %>
                                                        - <%= collector.area %>
                                                    </option>

                                                <% }) %>

                                            </select>

                                            <button
                                                type="submit"
                                                class="action-btn accept"
                                            >
                                                👤 Assign Collector
                                            </button>

                                        </form>

                                    <% } else { %>

                                        <div style="
                                            margin-top:15px;
                                            padding:15px;
                                            background:#fff8e1;
                                            border:1px solid #ffe082;
                                            border-radius:10px;
                                        ">
                                            ⚠️ No collectors available.
                                            Please create a collector profile first.
                                        </div>

                                    <% } %>

                                <% } else { %>

                                    <div style="
                                        margin-top:15px;
                                        padding:15px;
